# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:Aksh@2006@localhost:5432/student_org

# JWT Configuration (for local authentication)
JWT_SECRET=dev-secret-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay-secret-placeholder-minimum-32-chars
RAZORPAY_WEBHOOK_SECRET=webhook-secret-placeholder-minimum-32-chars

# Email Configuration (Nodemailer)
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=noreply@studentorg.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Guest Session Configuration
GUEST_SESSION_SECRET=guest-session-secret-change-in-production-minimum-32-characters
GUEST_OTP_SECRET=otp-secret-change-in-production-minimum-32-characters
GUEST_SESSION_EXPIRES_IN=24h
GUEST_OTP_EXPIRES_IN=10m
GUEST_OTP_MAX_ATTEMPTS=3
GUEST_OTP_RESEND_COOLDOWN=2m

# CORS Configuration
APP_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
OTP_RATE_LIMIT_MAX_REQUESTS=3

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# WebSocket
SOCKET_CORS_ORIGIN=http://localhost:5173
