		{"id":"signout","type":"text","text":"## 3. Sign out\n\nEnd the member session.","x":40,"y":1560,"width":340,"height":100},
		{"id":"return","type":"text","text":"## Return to Dashboard\n\nAfter completing an activity, the member can choose another section.","x":-20,"y":1280,"width":340,"height":130,"color":"5"}
